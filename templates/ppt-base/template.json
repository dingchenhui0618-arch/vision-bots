{
  "id": "ppt-base",
  "name": "PPT 底座",
  "engine": "ffmpeg",
  "ratio": "3:4",
  "ratios": ["3:4", "9:16"],
  "spec": {
    "fps": 30,
    "duration": [
      45,
      90
    ]
  },
  "layouts": {
    "3:4": {
      "size": [1080, 1440],
      "bg": "0x0c0c0d",
      "videoRect": { "x": 0, "y": 0, "w": 1080, "h": 1440 },
      "scrim": { "top": 380, "topAlpha": 0.42, "bottom": 340, "bottomAlpha": 0.46 },
      "type": {
        "head": { "font": "Microsoft YaHei", "size": 84, "x": 104, "y": 132, "hold": 1.7 },
        "index": { "font": "Cascadia Mono", "size": 34, "right": 104, "y": 140 },
        "caption": { "font": "Microsoft YaHei", "size": 74, "bottom": 128, "outline": 3 }
      }
    },
    "9:16": {
      "size": [1080, 1920],
      "bg": "0x0c0c0d",
      "videoRect": { "x": 0, "y": 0, "w": 1080, "h": 1920 },
      "scrim": { "top": 520, "topAlpha": 0.42, "bottom": 560, "bottomAlpha": 0.46 },
      "type": {
        "head": { "font": "Microsoft YaHei", "size": 92, "x": 96, "y": 168, "hold": 1.7 },
        "index": { "font": "Cascadia Mono", "size": 36, "right": 96, "y": 176 },
        "caption": { "font": "Microsoft YaHei", "size": 78, "bottom": 330, "outline": 3 }
      }
    }
  },
  "rules": {
    "chapters": "按句末标点 / 12 字 / 6.5 秒切章，不切断词；不足 4 字并入上一章",
    "head": "章节卡只在章首出现 1.7s，不长期压住画面",
    "safe": "文字离边 ≥ 80px；9:16 的 caption.bottom=330 给平台底部文案区让位，字幕不上抬到画面上沿"
  }
}
